# Append these settings to your existing .env. Keep your provider keys.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
MAIL_MODE=file
# Default is the project's data directory. Production must use a persistent private path.
# HYPERSENSE_DATA_DIR=/var/lib/hypersense
AI_DAILY_LIMIT=100

# Production example (replace placeholders; never commit credentials):
# APP_ENV=production
# APP_ORIGIN=https://interviews.example.com
# MAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=HyperSense <noreply@example.com>
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
