# Copy values into your host's private environment configuration.
# For local Docker use your existing .env with development mode and localhost origin.
APP_ENV=production
APP_ORIGIN=https://interview.example.com
HYPERSENSE_DATA_DIR=/var/lib/hypersense
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
GROQ_API_KEY=
GEMINI_API_KEY=
TRANSCRIPTION_PROVIDER=groq
WHISPER_MODEL=small
