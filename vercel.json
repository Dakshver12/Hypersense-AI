{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,static - Copy/**,templates - Copy/**,backups/**,data/**,.venv/**,node_modules/**,**/__pycache__/**,test-output.txt,*.dump,*.zip,*.mp3,*.webm}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "python scripts/build_vercel.py"
}
